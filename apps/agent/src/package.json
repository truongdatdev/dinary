{
	"name": "dinary-agent",
	"productName": "Dinary Agent",
	"version": "0.1.0",
	"description": "Dinary Agent",
	"license": "AGPL-3.0",
	"homepage": "https://dinary.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/truongdatdev/dinary.git"
	},
	"bugs": {
		"url": "https://github.com/truongdatdev/dinary/issues"
	},
	"private": true,
	"author": {
		"name": "Dinary",
		"email": "hello@dinary.app",
		"url": "https://dinary.app"
	},
	"main": "index.js",
	"build": {
		"appId": "com.dinary.dinaryagent",
		"artifactName": "${name}-${arch}-${version}.${ext}",
		"productName": "Dinary Agent",
		"copyright": "Copyright © 2019-Present. Ever Co. LTD and contributors; Dinary modifications © Dinary",
		"beforeBuild": "tools/electron/before-build.js",
		"afterSign": "tools/notarize.js",
		"dmg": {
			"sign": false,
			"artifactName": "${name}-${arch}-${version}.${ext}"
		},
		"asar": true,
		"npmRebuild": true,
		"asarUnpack": [],
		"directories": {
			"buildResources": "icons",
			"output": "../agent-packages"
		},
		"publish": [
			{
				"provider": "github",
				"repo": "dinary-agent",
				"releaseType": "release"
			}
		],
		"mac": {
			"minimumSystemVersion": "13.0",
			"category": "public.app-category.developer-tools",
			"icon": "icon.icns",
			"target": {
				"target": "default",
				"arch": [
					"x64",
					"arm64"
				]
			},
			"asarUnpack": "**/*.node",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "tools/build/entitlements.mas.plist",
			"entitlementsInherit": "tools/build/entitlements.mas.plist",
			"extendInfo": {
				"NSAppleEventsUsageDescription": "This app requires access to script browser applications to detect the current URL when triggering instant lookup.",
				"NSCameraUsageDescription": "Please allow access to the device camera to capture images and videos.",
				"NSMicrophoneUsageDescription": "Please allow access to the device's microphone to capture audio and voice recordings.",
				"NSScreenCaptureUsageDescription": "Please allow access to the device's screen to capture screenshots and videos."
			}
		},
		"win": {
			"target": "nsis",
			"icon": "icon.ico"
		},
		"snap": {
			"base": "core22"
		},
		"linux": {
			"icon": "linux",
			"target": [
				"deb",
				"snap",
				"tar.gz",
				"rpm",
				"AppImage",
				"flatpak"
			],
			"executableName": "dinary-agent",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"synopsis": "Desktop",
			"category": "Development"
		},
		"flatpak": {
			"useWaylandFlags": true,
			"finishArgs": [
				"--share=ipc",
				"--socket=x11",
				"--socket=wayland",
				"--socket=pulseaudio",
				"--share=network",
				"--device=dri",
				"--filesystem=home",
				"--talk-name=org.freedesktop.Notifications",
				"--talk-name=org.kde.StatusNotifierWatcher",
				"--talk-name=org.freedesktop.portal.Desktop",
				"--system-talk-name=org.freedesktop.login1",
				"--env=ELECTRON_TRASH=gio",
				"--env=TMPDIR=/var/tmp",
				"--env=ELECTRON_ENABLE_LOGGING=1",
				"--env=ELECTRON_OZONE_PLATFORM_HINT=auto"
			],
			"runtime": "org.freedesktop.Platform",
			"runtimeVersion": "24.08",
			"sdk": "org.freedesktop.Sdk",
			"base": "org.electronjs.Electron2.BaseApp",
			"baseVersion": "24.08"
		},
		"rpm": {
			"fpm": [
				"--rpm-rpmbuild-define",
				"_build_id_links none"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"allowToChangeInstallationDirectory": true,
			"allowElevation": true,
			"installerIcon": "icon.ico",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"deleteAppDataOnUninstall": true,
			"menuCategory": true
		},
		"extraResources": [
			"./data/**/*",
			"databaseDir",
			{
				"from": "assets",
				"to": "assets"
			}
		]
	},
	"dependencies": {
		"electron-log": "^5.4.4",
		"electron-store": "^12.0.0",
		"electron-updater": "^6.8.9",
		"electron-util": "^1.0.0",
		"node-fetch": "^3.3.2",
		"node-notifier": "^11.0.0",
		"@dinary/common": "file:../../../dist/packages/common",
		"@dinary/contracts": "file:../../../dist/packages/contracts",
		"@dinary/desktop-core": "file:../../../dist/packages/desktop-core",
		"@dinary/desktop-activity": "file:../../../dist/packages/desktop-activity",
		"@dinary/desktop-lib": "file:../../../dist/packages/desktop-lib",
		"@dinary/desktop-window": "file:../../../dist/packages/desktop-window",
		"@dinary/ui-config": "file:../../../dist/packages/ui-config",
		"@dinary/constants": "file:../../../dist/packages/constants",
		"@electron/remote": "^2.1.3",
		"@sentry/electron": "8.1.0",
		"@sentry/profiling-node": "11.4.0",
		"@sentry/node": "11.4.0",
		"@sentry/core": "11.4.0",
		"auto-launch": "5.0.6",
		"custom-electron-titlebar": "^4.4.1",
		"form-data": "^4.0.6",
		"call-bind-apply-helpers": "^1.0.2",
		"cheerio-select": "^2.1.0",
		"is-online": "^12.0.2"
	},
	"resolutions": {
		"@dinary/common": "file:../../../dist/packages/common",
		"@dinary/contracts": "file:../../../dist/packages/contracts",
		"@dinary/desktop-core": "file:../../../dist/packages/desktop-core",
		"@dinary/desktop-activity": "file:../../../dist/packages/desktop-activity",
		"@dinary/desktop-lib": "file:../../../dist/packages/desktop-lib",
		"@dinary/desktop-window": "file:../../../dist/packages/desktop-window",
		"@dinary/ui-config": "file:../../../dist/packages/ui-config",
		"@dinary/constants": "file:../../../dist/packages/constants",
		"knex": "3.3.0",
		"uiohook-napi": "1.5.5",
		"**/embedded-queue/nedb": "npm:@seald-io/nedb@^4.1.2",
		"**/embedded-queue/uuid": "^11.1.1",
		"**/better-queue/uuid": "^11.1.1",
		"**/get-windows/@mapbox/node-pre-gyp": "^2.0.3",
		"**/get-windows/node-gyp": "^13.1.0"
	}
}
