{
	"name": "dinary-mcp-server",
	"productName": "Dinary MCP Server",
	"version": "0.1.0",
	"description": "Dinary MCP Server",
	"license": "AGPL-3.0",
	"homepage": "https://dinary.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/truongdatdev/dinary.git"
	},
	"bugs": {
		"url": "https://github.com/truongdatdev/dinary/issues"
	},
	"private": true,
	"author": {
		"name": "Dinary",
		"email": "hello@dinary.app",
		"url": "https://dinary.app"
	},
	"main": "main.js",
	"bin": {
		"dinary-mcp": "./main.js"
	},
	"build": {
		"npmArgs": [
			"--production"
		],
		"appId": "com.dinary.dinarymcpserver",
		"artifactName": "${name}-${arch}-${version}.${ext}",
		"productName": "Dinary MCP Server",
		"copyright": "Copyright © 2019-Present. Ever Co. LTD and contributors; Dinary modifications © Dinary",
		"beforeBuild": "tools/electron/before-build.js",
		"afterSign": "tools/notarize.js",
		"dmg": {
			"sign": false,
			"artifactName": "${name}-${arch}-${version}.${ext}"
		},
		"asar": true,
		"npmRebuild": true,
		"asarUnpack": [
			"node_modules/@sentry/electron",
			"node_modules/@sentry/profiling-node/lib"
		],
		"directories": {
			"buildResources": "icons",
			"output": "../desktop-packages"
		},
		"publish": [
			{
				"provider": "github",
				"repo": "dinary-mcp-server",
				"releaseType": "release"
			}
		],
		"mac": {
			"minimumSystemVersion": "13.0",
			"category": "public.app-category.developer-tools",
			"icon": "icon.icns",
			"target": {
				"target": "default",
				"arch": [
					"x64",
					"arm64"
				]
			},
			"asarUnpack": "**/*.node",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "tools/build/entitlements.mas.plist",
			"entitlementsInherit": "tools/build/entitlements.mas.plist",
			"extendInfo": {}
		},
		"win": {
			"target": "nsis",
			"icon": "icon.ico",
			"requestedExecutionLevel": "requireAdministrator"
		},
		"snap": {
			"base": "core22"
		},
		"linux": {
			"icon": "linux",
			"target": [
				"deb",
				"snap",
				"tar.gz",
				"rpm",
				"AppImage"
			],
			"executableName": "dinary-mcp-server",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"synopsis": "Server",
			"category": "Development"
		},
		"rpm": {
			"fpm": [
				"--rpm-rpmbuild-define",
				"_build_id_links none"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"allowToChangeInstallationDirectory": true,
			"allowElevation": true,
			"installerIcon": "icon.ico",
			"artifactName": "${name}-${arch}-${version}.${ext}",
			"deleteAppDataOnUninstall": true,
			"menuCategory": true
		},
		"extraResources": [
			"./data/**/*"
		]
	},
	"dependencies": {
		"@dinary/mcp-server": "file:../../../dist/packages/mcp-server",
		"@dinary/auth": "file:../../../dist/packages/auth",
		"@dinary/config": "file:../../../dist/packages/config",
		"@dinary/contracts": "file:../../../dist/packages/contracts",
		"@dinary/utils": "file:../../../dist/packages/utils",
		"@dinary/common": "file:../../../dist/packages/common",
		"@dinary/constants": "file:../../../dist/packages/constants",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"axios": "^1.20.0",
		"dotenv": "^18.0.7",
		"zod": "^4.6.7",
		"@sentry/electron": "8.1.0",
		"@sentry/node": "11.4.0",
		"@sentry/profiling-node": "11.4.0",
		"@sentry/core": "11.4.0",
		"electron-log": "^5.4.4",
		"electron-store": "^12.0.0",
		"electron-updater": "^6.8.9",
		"electron-util": "^1.0.0",
		"custom-electron-titlebar": "^4.4.1"
	},
	"resolutions": {
		"**/@mikro-orm/better-sqlite/better-sqlite3": "13.0.3",
		"@dinary/mcp-server": "file:../../../dist/packages/mcp-server",
		"@dinary/auth": "file:../../../dist/packages/auth",
		"@dinary/config": "file:../../../dist/packages/config",
		"@dinary/contracts": "file:../../../dist/packages/contracts",
		"@dinary/utils": "file:../../../dist/packages/utils",
		"@dinary/common": "file:../../../dist/packages/common",
		"@dinary/constants": "file:../../../dist/packages/constants",
		"knex": "3.3.0",
		"**/xtraverse/xmldom": "npm:@xmldom/xmldom@^0.8.15",
		"**/@nestjs/platform-express/multer": "^2.5.0"
	},
	"pkg": {
		"assets": [],
		"targets": [
			"node20-linux-x64",
			"node20-mac-x64",
			"node20-win-x64"
		]
	}
}
