{
	"name": "dinary",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/dinary/src",
	"prefix": "dinary",
	"generators": {
		"@nx/workspace:component": {
			"style": "scss"
		}
	},
	"targets": {
		"build": {
			"executor": "@angular-builders/custom-webpack:browser",
			"options": {
				"preserveSymlinks": true,
				"aot": true,
				"customWebpackConfig": {
					"path": "apps/dinary/config/custom-webpack.config.js"
				},
				"outputPath": "dist/apps/dinary",
				"index": "apps/dinary/src/index.html",
				"main": "apps/dinary/src/main.ts",
				"polyfills": "apps/dinary/src/polyfills.ts",
				"tsConfig": "apps/dinary/tsconfig.app.json",
				"stylePreprocessorOptions": {
					"includePaths": ["packages/ui-core/static/styles"]
				},
				"assets": [
					"apps/dinary/src/favicon.ico",
					"apps/dinary/src/assets",
					"apps/dinary/src/manifest.json",
					"apps/dinary/src/silent-refresh.html",
					{
						"glob": "**/*",
						"input": "packages/ui-core/i18n/assets/i18n",
						"output": "assets/i18n/"
					},
					{
						"glob": "**/*",
						"input": "node_modules/pdfjs-dist/wasm",
						"ignore": ["quickjs-eval.*"],
						"output": "assets/pdfjs/wasm/"
					}
				],
				"styles": [
					"node_modules/@nebular/theme/styles/prebuilt/default.css",
					"node_modules/bootstrap/dist/css/bootstrap.css",
					"node_modules/typeface-exo/index.css",
					"node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
					"node_modules/ionicons/dist/scss/ionicons.scss",
					"node_modules/@fortawesome/fontawesome-free/css/all.css",
					"node_modules/socicon/css/socicon.css",
					"node_modules/@ali-hm/angular-tree-component/css/angular-tree-component.css",
					"node_modules/leaflet/dist/leaflet.css",
					"packages/ui-core/static/styles/styles.scss",
					"node_modules/@ng-select/ng-select/themes/default.theme.css",
					"node_modules/streamdown/styles.css",
					"node_modules/katex/dist/katex.min.css"
				],
				"scripts": ["node_modules/chart.js/dist/chart.umd.min.js"],
				"allowedCommonJsDependencies": [
					"@dinary/contracts",
					"@dinary/ui-config",
					"brace",
					"brace/mode/handlebars",
					"camelcase",
					"dayjs",
					"deepmerge",
					"file-saver",
					"jalaali-js",
					"leaflet",
					"localforage",
					"mobx",
					"moment",
					"moment-duration-format",
					"moment-range",
					"moment-timezone",
					"randomcolor",
					"slugify",
					"underscore.string"
				]
			},
			"configurations": {
				"production": {
					"fileReplacements": [
						{
							"replace": "packages/ui-config/src/lib/environments/environment.ts",
							"with": "packages/ui-config/src/lib/environments/environment.prod.ts"
						}
					],
					"optimization": true,
					"outputHashing": "all",
					"serviceWorker": false,
					"sourceMap": false,
					"namedChunks": false,
					"ngswConfigPath": "apps/dinary/ngsw-config.prod.json",
					"aot": true,
					"extractLicenses": true,
					"vendorChunk": true,
					"buildOptimizer": true,
					"statsJson": false,
					"progress": true,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "1000kb",
							"maximumError": "2000kb"
						}
					]
				},
				"development": {
					"outputHashing": "all"
				},
				"local": {
					"optimization": false,
					"buildOptimizer": false,
					"vendorChunk": true,
					"extractLicenses": false,
					"sourceMap": true,
					"namedChunks": true,
					"progress": false,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "1000kb",
							"maximumError": "20mb"
						}
					]
				},
				"ci": {
					"optimization": false,
					"buildOptimizer": false,
					"vendorChunk": true,
					"extractLicenses": false,
					"sourceMap": false,
					"namedChunks": true,
					"progress": false,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "1000kb",
							"maximumError": "20mb"
						}
					]
				}
			}
		},
		"serve": {
			"executor": "@angular-builders/custom-webpack:dev-server",
			"defaultConfiguration": "local",
			"options": {
				"buildTarget": "dinary:build",
				"proxyConfig": "apps/dinary/proxy.conf.json",
				"liveReload": true
			},
			"configurations": {
				"production": {
					"buildTarget": "dinary:build:production",
					"proxyConfig": "apps/dinary/proxy.prod.conf.json"
				},
				"local": {
					"buildTarget": "dinary:build:local",
					"proxyConfig": "apps/dinary/proxy.conf.json",
					"liveReload": true,
					"poll": 0
				}
			}
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "dinary:build"
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"options": {
				"jestConfig": "apps/dinary/jest.config.ts",
				"tsConfig": "apps/dinary/tsconfig.spec.json"
			}
		},
		"desktop-ui": {
			"executor": "@angular-builders/custom-webpack:browser",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "development",
			"options": {
				"customWebpackConfig": {
					"path": "apps/desktop/config/custom-webpack.config.js"
				},
				"outputPath": "dist/apps/desktop",
				"index": "apps/dinary/src/index.html",
				"main": "apps/dinary/src/main.ts",
				"polyfills": "apps/dinary/src/polyfills.ts",
				"tsConfig": "apps/dinary/tsconfig.app.json",
				"stylePreprocessorOptions": {
					"includePaths": ["packages/ui-core/static/styles"]
				},
				"assets": [
					"apps/dinary/src/favicon.ico",
					"apps/dinary/src/assets",
					"apps/dinary/src/manifest.json",
					"apps/dinary/src/silent-refresh.html",
					{
						"glob": "**/*",
						"input": "apps/desktop/src/",
						"ignore": ["**/*.ts"],
						"output": ""
					},
					{
						"glob": "**/*",
						"input": "packages/ui-core/i18n/assets/i18n",
						"output": "assets/i18n/"
					},
					{
						"glob": "**/*",
						"input": "node_modules/pdfjs-dist/wasm",
						"ignore": ["quickjs-eval.*"],
						"output": "assets/pdfjs/wasm/"
					}
				],
				"styles": [
					"node_modules/@nebular/theme/styles/prebuilt/default.css",
					"node_modules/bootstrap/dist/css/bootstrap.css",
					"node_modules/typeface-exo/index.css",
					"node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
					"node_modules/ionicons/dist/scss/ionicons.scss",
					"node_modules/@fortawesome/fontawesome-free/css/all.css",
					"node_modules/socicon/css/socicon.css",
					"node_modules/@ali-hm/angular-tree-component/css/angular-tree-component.css",
					"node_modules/leaflet/dist/leaflet.css",
					"packages/ui-core/static/styles/styles.scss",
					"node_modules/@ng-select/ng-select/themes/default.theme.css",
					"node_modules/streamdown/styles.css",
					"node_modules/katex/dist/katex.min.css"
				],
				"scripts": ["node_modules/chart.js/dist/chart.umd.min.js"],
				"allowedCommonJsDependencies": [
					"@dinary/contracts",
					"@dinary/ui-config",
					"brace",
					"brace/mode/handlebars",
					"camelcase",
					"dayjs",
					"deepmerge",
					"file-saver",
					"jalaali-js",
					"leaflet",
					"localforage",
					"mobx",
					"moment",
					"moment-duration-format",
					"moment-range",
					"moment-timezone",
					"randomcolor",
					"rxjs",
					"slugify",
					"underscore.string"
				]
			},
			"configurations": {
				"development": {
					"optimization": false,
					"sourceMap": true,
					"namedChunks": true,
					"extractLicenses": false,
					"vendorChunk": true,
					"buildOptimizer": false,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						}
					]
				},
				"production": {
					"fileReplacements": [
						{
							"replace": "apps/desktop/src/environments/environment.ts",
							"with": "apps/desktop/src/environments/environment.prod.ts"
						},
						{
							"replace": "packages/ui-config/src/lib/environments/environment.ts",
							"with": "packages/ui-config/src/lib/environments/environment.prod.ts"
						}
					],
					"optimization": true,
					"outputHashing": "all",
					"serviceWorker": true,
					"sourceMap": true,
					"namedChunks": false,
					"ngswConfigPath": "apps/dinary/ngsw-config.prod.json",
					"aot": true,
					"extractLicenses": false,
					"vendorChunk": false,
					"buildOptimizer": false,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						}
					]
				}
			}
		},
		"server-ui": {
			"executor": "@angular-builders/custom-webpack:browser",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "development",
			"options": {
				"customWebpackConfig": {
					"path": "apps/dinary/config/custom-webpack.config.js"
				},
				"outputPath": "dist/apps/dinary-server/data/ui",
				"index": "apps/dinary/src/index.html",
				"main": "apps/dinary/src/main.ts",
				"polyfills": "apps/dinary/src/polyfills.ts",
				"tsConfig": "apps/dinary/tsconfig.app.json",
				"stylePreprocessorOptions": {
					"includePaths": ["packages/ui-core/static/styles"]
				},
				"assets": [
					"apps/dinary/src/favicon.ico",
					"apps/dinary/src/assets",
					"apps/dinary/src/manifest.json",
					"apps/dinary/src/silent-refresh.html",
					{
						"glob": "**/*",
						"input": "packages/ui-core/i18n/assets/i18n",
						"output": "assets/i18n/"
					},
					{
						"glob": "**/*",
						"input": "node_modules/pdfjs-dist/wasm",
						"ignore": ["quickjs-eval.*"],
						"output": "assets/pdfjs/wasm/"
					}
				],
				"styles": [
					"node_modules/bootstrap/dist/css/bootstrap.css",
					"node_modules/typeface-exo/index.css",
					"node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
					"node_modules/ionicons/dist/scss/ionicons.scss",
					"node_modules/@fortawesome/fontawesome-free/css/all.css",
					"node_modules/socicon/css/socicon.css",
					"node_modules/@ali-hm/angular-tree-component/css/angular-tree-component.css",
					"node_modules/leaflet/dist/leaflet.css",
					"packages/ui-core/static/styles/styles.scss",
					"node_modules/@ng-select/ng-select/themes/default.theme.css",
					"node_modules/streamdown/styles.css",
					"node_modules/katex/dist/katex.min.css"
				],
				"scripts": ["node_modules/chart.js/dist/chart.umd.min.js"],
				"allowedCommonJsDependencies": [
					"@dinary/contracts",
					"@dinary/ui-config",
					"brace",
					"brace/mode/handlebars",
					"camelcase",
					"dayjs",
					"deepmerge",
					"file-saver",
					"jalaali-js",
					"leaflet",
					"localforage",
					"mobx",
					"moment",
					"moment-duration-format",
					"moment-range",
					"moment-timezone",
					"randomcolor",
					"slugify",
					"underscore.string"
				]
			},
			"configurations": {
				"development": {
					"optimization": false,
					"sourceMap": true,
					"namedChunks": true,
					"extractLicenses": false,
					"vendorChunk": true,
					"buildOptimizer": false,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						}
					]
				},
				"production": {
					"fileReplacements": [
						{
							"replace": "packages/ui-config/src/lib/environments/environment.ts",
							"with": "packages/ui-config/src/lib/environments/environment.prod.ts"
						}
					],
					"optimization": true,
					"outputHashing": "all",
					"serviceWorker": true,
					"sourceMap": false,
					"namedChunks": false,
					"ngswConfigPath": "apps/dinary/ngsw-config.prod.json",
					"aot": true,
					"extractLicenses": false,
					"vendorChunk": false,
					"buildOptimizer": true,
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "100mb",
							"maximumError": "150mb"
						}
					]
				}
			}
		}
	}
}
