{
	"name": "@dinary/plugin-inbox-ui",
	"version": "0.1.0",
	"description": "Dinary UI plugin for the Inbox: /pages/inbox (tabs, filters, detail panes, replies, sandboxed email viewer, Notifications tab) and the header badge; shown only where the API loads @dinary/plugin-inbox",
	"author": {
		"name": "Ordinary Labs",
		"url": "https://github.com/ordinary-labs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ordinary-labs/dinary",
		"directory": "packages/plugins/inbox-ui"
	},
	"bugs": {
		"url": "https://github.com/ordinary-labs/dinary/issues"
	},
	"homepage": "https://github.com/ordinary-labs/dinary/tree/develop/packages/plugins/inbox-ui",
	"license": "AGPL-3.0",
	"private": true,
	"scripts": {
		"lib:build": "yarn nx build plugin-inbox-ui --configuration=development",
		"lib:build:prod": "yarn nx build plugin-inbox-ui --configuration=production",
		"lib:watch": "yarn nx build plugin-inbox-ui --watch --configuration=development"
	},
	"peerDependencies": {
		"@angular/common": "22.2.2",
		"@angular/core": "22.2.2",
		"@angular/forms": "22.2.2",
		"@angular/router": "22.2.2"
	},
	"dependencies": {
		"@dinary/contracts": "^0.1.0",
		"@dinary/plugin-ui": "^0.1.0",
		"@dinary/ui-core": "^0.1.0",
		"@nebular/theme": "^18.0.0",
		"@ngx-translate/core": "^18.0.0",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@types/jest": "30.0.0",
		"@types/node": "^26.6.5",
		"jest-preset-angular": "17.0.2"
	},
	"keywords": [
		"dinary",
		"inbox",
		"notifications",
		"approvals",
		"ui",
		"angular",
		"plugin"
	],
	"engines": {
		"node": ">=26",
		"yarn": ">=1.22"
	},
	"sideEffects": false
}
