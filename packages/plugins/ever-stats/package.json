{
	"name": "@dinary/plugin-ever-stats",
	"version": "0.1.0",
	"description": "Dinary Platform plugin that sends one anonymous usage statistics report a day (counts and monthly totals only), signed, with a published schema; on by default and switched off with EVER_STATS_ENABLED=false or in Settings",
	"author": {
		"name": "Dinary",
		"email": "hello@dinary.app",
		"url": "https://dinary.app"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/truongdatdev/dinary",
		"directory": "packages/plugins/ever-stats"
	},
	"bugs": {
		"url": "https://github.com/truongdatdev/dinary/issues"
	},
	"homepage": "https://dinary.app",
	"license": "AGPL-3.0",
	"private": true,
	"type": "commonjs",
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"scripts": {
		"lib:build": "yarn nx build plugin-ever-stats",
		"lib:build:prod": "yarn nx build plugin-ever-stats",
		"lib:watch": "yarn nx build plugin-ever-stats --watch"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/core": "^12.0.0"
	},
	"dependencies": {
		"@ever-co/connect-contracts": "1.0.0-rc.7",
		"@ever-co/connect-sdk": "1.0.0-rc.7",
		"@dinary/common": "^0.1.0",
		"@dinary/config": "^0.1.0",
		"@dinary/constants": "^0.1.0",
		"@dinary/contracts": "^0.1.0",
		"@dinary/core": "^0.1.0",
		"@dinary/plugin": "^0.1.0",
		"@dinary/plugin-ever-instance": "^0.1.0",
		"@mikro-orm/core": "^6.6.17",
		"@nestjs/swagger": "^12.0.2",
		"nestjs-cls": "^7.0.1",
		"tslib": "^2.8.1",
		"typeorm": "^1.1.2"
	},
	"devDependencies": {
		"@ever-co/connect-tools": "1.0.0-rc.7",
		"@types/jest": "30.0.0",
		"@types/node": "^26.6.5",
