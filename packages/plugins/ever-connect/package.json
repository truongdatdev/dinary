		"directory": "packages/plugins/ever-connect"
	},
	"bugs": {
		"url": "https://github.com/ordinary-labs/dinary/issues"
	},
	"homepage": "https://ordinarylabs.com",
	"license": "AGPL-3.0",
	"private": true,
	"type": "commonjs",
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"scripts": {
		"lib:build": "yarn nx build plugin-ever-connect",
