		"react-dom": "^19.3.0",
		"rxjs": "^7.0.0"
	},
	"devDependencies": {
		"@types/jest": "30.0.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jest-preset-angular": "17.0.2"
	},
	"keywords": [
		"dinary",
		"ui-react",
		"angular",
		"react",
		"plugin",
		"dinary"
	],
	"engines": {
		"node": ">=26",
		"yarn": ">=1.22"
	},
	"sideEffects": false
