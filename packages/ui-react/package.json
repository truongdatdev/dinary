{
	"name": "@dinary/ui-react",
	"version": "0.1.0",
	"description": "React-to-Angular bridge for Dinary UI plugins. Renders React components inside Angular with access to Angular services.",
	"author": {
		"name": "Dinary",
		"email": "hello@dinary.app",
		"url": "https://dinary.app"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/truongdatdev/dinary",
		"directory": "packages/ui-react"
	},
	"bugs": {
		"url": "https://github.com/truongdatdev/dinary/issues"
	},
	"homepage": "https://dinary.app",
	"license": "AGPL-3.0",
	"private": true,
	"scripts": {
		"lib:build": "yarn nx build ui-react --configuration=development",
		"lib:build:prod": "yarn nx build ui-react --configuration=production",
		"lib:watch": "yarn nx build ui-react --watch --configuration=development"
	},
	"peerDependencies": {
		"@angular/common": "22.2.2",
		"@angular/core": "22.2.2",
		"@dinary/plugin-ui": "*",
